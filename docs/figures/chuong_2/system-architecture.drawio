<mxfile>
  <diagram id="microservices-arch" name="Microservices Architecture Diagram">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="660" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Tier 1: Web Client -->
        <mxCell id="client" value="Web Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="160" height="46" as="geometry" />
        </mxCell>

        <!-- Tier 2: API Gateway -->
        <mxCell id="gateway" value="API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="310" y="110" width="180" height="48" as="geometry" />
        </mxCell>

        <!-- Tier 3: Account Service (Left), Payment Service (Center), Tuition Service (Right) -->
        <!-- Account Service + account_db -->
        <mxCell id="svc_account" value="Account Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="45" y="240" width="165" height="50" as="geometry" />
        </mxCell>

        <mxCell id="db_account" value="account_db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="67.5" y="340" width="120" height="64" as="geometry" />
        </mxCell>

        <!-- Payment Service + payment_db -->
        <mxCell id="svc_payment" value="Payment Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="317.5" y="240" width="165" height="50" as="geometry" />
        </mxCell>

        <mxCell id="db_payment" value="payment_db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="285" y="340" width="120" height="64" as="geometry" />
        </mxCell>

        <!-- Tuition Service + tuition_db -->
        <mxCell id="svc_tuition" value="Tuition Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="590" y="240" width="165" height="50" as="geometry" />
        </mxCell>

        <mxCell id="db_tuition" value="tuition_db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="612.5" y="340" width="120" height="64" as="geometry" />
        </mxCell>

        <!-- Tier 4: Notification Service + notification_db + SMTP Server -->
        <mxCell id="svc_notif" value="Notification Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="372.5" y="455" width="165" height="50" as="geometry" />
        </mxCell>

        <mxCell id="db_notif" value="notification_db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="395" y="555" width="120" height="64" as="geometry" />
        </mxCell>

        <mxCell id="smtp" value="SMTP Server" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="610" y="455" width="145" height="50" as="geometry" />
        </mxCell>

        <!-- Edge: Web Client -> API Gateway -->
        <mxCell id="e_client_gw" value="HTTP/REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="client" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: API Gateway -> Account Service (left), Payment Service (center), Tuition Service (right) -->
        <mxCell id="e_gw_acc" value="HTTP/REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gateway" target="svc_account">
          <mxGeometry x="-0.35" y="-12" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="127.5" y="134" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_gw_pay" value="HTTP/REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gateway" target="svc_payment">
          <mxGeometry x="0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_gw_tui" value="HTTP/REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gateway" target="svc_tuition">
          <mxGeometry x="-0.35" y="12" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="672.5" y="134" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Inter-service communication from Payment Service (Zero crossings!) -->
        <!-- Payment -> Account (direct horizontal left) -->
        <mxCell id="e_pay_acc" value="HTTP/REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;dashPattern=5 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc_payment" target="svc_account">
          <mxGeometry y="-12" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Payment -> Tuition (direct horizontal right) -->
        <mxCell id="e_pay_tui" value="HTTP/REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;dashPattern=5 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc_payment" target="svc_tuition">
          <mxGeometry y="12" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Payment -> Notification (direct vertical down from x=455) -->
        <mxCell id="e_pay_notif" value="HTTP/REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.833;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;dashPattern=5 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc_payment" target="svc_notif">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: Services -> Databases (All 4 straight vertical!) -->
        <mxCell id="e_acc_db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="svc_account" target="db_account">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_pay_db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.167;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="svc_payment" target="db_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_tui_db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="svc_tuition" target="db_tuition">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_notif_db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="svc_notif" target="db_notif">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Notification Service -> SMTP Server (direct horizontal right!) -->
        <mxCell id="e_notif_smtp" value="SMTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc_notif" target="smtp">
          <mxGeometry y="-12" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
